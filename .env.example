# ============================================================
# Tickr 환경변수 예시
# 실제 값은 .env (gitignored) 에 작성. 이 파일은 키 목록 참조용.
# ============================================================

# ─── Supabase (apps/api 서버 전용 — 비밀, EXPO_PUBLIC_ 금지) ─
# 아래 3종은 클라이언트 번들에 노출되면 사고. 절대 EXPO_PUBLIC_* 로 옮기지 말 것.
# 검증: grep -E '^EXPO_PUBLIC_.*(SERVICE_ROLE|JWT_SECRET|APP_SECRET)' .env .env.example → 0건
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # 🔒 서버 전용 — DB RLS 우회 가능. 노출 시 즉시 회전
SUPABASE_JWT_SECRET=         # 🔒 서버 전용 — JWT 위조 가능. 노출 시 즉시 회전

# ─── KIS Developers OpenAPI (apps/api 서버 전용) ──────────
# KIS_USE_MOCK=true 이면 모의투자 서버 사용, false 이면 실전 서버 사용
KIS_USE_MOCK=true
KIS_APP_KEY=
KIS_APP_SECRET=
# 실전: https://openapi.koreainvestment.com:9443
# 모의: https://openapivts.koreainvestment.com:29443
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
# 개발자 본인 모의계좌 (시세 조회/주문 호출 테스트용, 종합계좌번호 8자리)
KIS_ACCOUNT_NO=
# 계좌상품코드 (모의·실전 모두 종합주식 = 01)
KIS_ACCOUNT_PROD_CD=01

# ─── API 서버 자체 설정 ────────────────────────────────────
API_PORT=4000
NODE_ENV=development

# ─── apps/mobile (Expo) ───────────────────────────────────
# EXPO_PUBLIC_ 접두사가 붙은 변수만 클라이언트 번들에 노출됨.
# 절대 SERVICE_ROLE / JWT_SECRET / APP_SECRET 같은 비밀키는 EXPO_PUBLIC_* 에 두지 말 것.
# 로컬 호스트는 127.0.0.1 사용 — localhost는 IPv6 우선이라 false-negative 위험.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_WS_URL=ws://127.0.0.1:4000/ws
# development | production — env.ts의 isDev 분기 기반
EXPO_PUBLIC_APP_ENV=development
