{
  "name": "tickr",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:mobile": "turbo run dev --filter=@tickr/mobile",
    "dev:api": "turbo run dev --filter=@tickr/api",
    "ios": "pnpm --filter @tickr/mobile ios",
    "android": "pnpm --filter @tickr/mobile android",
    "mobile:qr": "pnpm --filter @tickr/mobile dev:qr",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "lefthook": "^2.1.8",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
